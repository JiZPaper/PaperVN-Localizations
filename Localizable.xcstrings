    "加载发行版本超时，请检查网络后再试。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung beim Laden der Veröffentlichungen. Prüfe deine Netzwerkverbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading release versions timed out. Check your network connection and try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リリースバージョンの読み込みがタイムアウトしました。ネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출시 버전을 불러오는 데 시간이 초과되었습니다. 네트워크 연결을 확인한 후 다시 시도해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekroczono limit czasu wczytywania wydań. Sprawdź połączenie z siecią i spróbuj ponownie."
