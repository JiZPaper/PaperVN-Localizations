    "家长控制" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kindersicherung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parental Controls"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロール"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀 보호 기능"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrola rodzicielska"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家長控制"
          }
        }
      }
    },
    "家长控制或年龄范围控制将覆盖当前用户设置。按照家长要求或共享年龄范围隐藏不安全的内容，并限制不受信任的外部链接。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kindersicherung oder die Altersbereichssteuerung überschreibt die aktuellen Benutzereinstellungen. Unsichere Inhalte werden gemäß den Vorgaben der Eltern oder dem geteilten Altersbereich ausgeblendet und nicht vertrauenswürdige externe Links eingeschränkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parental Controls or age-range controls override the current user settings. Unsafe content is hidden based on parental requirements or the shared age range, and untrusted external links are restricted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロールまたは年齢範囲による制限は、現在のユーザー設定より優先されます。保護者の要件または共有された年齢範囲に従って安全でないコンテンツを非表示にし、信頼されていない外部リンクを制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀 보호 기능 또는 연령 범위 제어가 현재 사용자 설정보다 우선합니다. 보호자 요구 사항이나 공유된 연령 범위에 따라 안전하지 않은 콘텐츠를 숨기고 신뢰할 수 없는 외부 링크를 제한합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrola rodzicielska lub kontrola zakresu wieku zastąpi bieżące ustawienia użytkownika. Niebezpieczne treści będą ukrywane zgodnie z wymaganiami rodziców lub udostępnionym zakresem wieku, a niezaufane linki zewnętrzne zostaną ograniczone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家長控制或年齡範圍控制會覆寫目前的使用者設定。系統會按照家長要求或分享的年齡範圍隱藏不安全的內容，並限制不受信任的外部連結。"
          }
        }
      }
    },
    "家长控制生效期间不能打开此站点。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Website kann bei aktivierter Kindersicherung nicht geöffnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This website can’t be opened while Parental Controls are active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロールが有効な間は、このWebサイトを開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자녀 보호 기능이 활성화된 동안에는 이 웹 사이트를 열 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej witryny nie można otworzyć, gdy kontrola rodzicielska jest aktywna."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家長控制生效期間無法開啟此網站。"
          }
        }
      }
    },
    "宽松" : {
      "localizations" : {
