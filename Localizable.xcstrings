          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品の詳細から、概要の翻訳エラーや音楽のマッチングエラーの報告、音楽の追加ができます。投稿と返信は審査後に公開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
