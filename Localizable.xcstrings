    "加权平均" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewichteter Durchschnitt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weighted Average"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重平均"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가중 평균"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Średnia ważona"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加權平均"
          }
        }
      }
    },
    "加权平均按各平台的评分人数分配权重，评分人数越多的平台占比越大；AniList没有公开评分人数，按人气计算。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim gewichteten Durchschnitt zählt jeder Dienst entsprechend seiner Anzahl an Bewertungen. AniList veröffentlicht diese Anzahl nicht, daher wird stattdessen die Beliebtheit verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weighted Average weights each service by its number of ratings, so services with more ratings count more. AniList doesn’t publish its number of ratings, so its popularity is used instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重平均では各サービスの評価人数に応じて重みを付け、評価人数が多いサービスほど比重が大きくなります。AniListは評価人数を公開していないため、人気度で計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가중 평균은 각 서비스의 평가 인원수에 따라 가중치를 두며, 평가 인원이 많은 서비스일수록 비중이 커집니다. AniList는 평가 인원수를 공개하지 않으므로 인기도로 계산합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Średnia ważona uwzględnia liczbę ocen w każdym serwisie – serwisy z większą liczbą ocen mają większy wpływ. AniList nie podaje liczby ocen, dlatego używana jest popularność."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加權平均按各平台的評分人數分配權重，評分人數越多的平台佔比越大；AniList沒有公開評分人數，按人氣計算。"
          }
        }
      }
    },
    "加权平均按各平台的评分人数分配权重，评分人数越多的平台占比越大。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim gewichteten Durchschnitt zählt jeder Dienst entsprechend seiner Anzahl an Bewertungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weighted Average weights each service by its number of ratings, so services with more ratings count more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加重平均では各サービスの評価人数に応じて重みを付け、評価人数が多いサービスほど比重が大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가중 평균은 각 서비스의 평가 인원수에 따라 가중치를 두며, 평가 인원이 많은 서비스일수록 비중이 커집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Średnia ważona uwzględnia liczbę ocen w każdym serwisie – serwisy z większą liczbą ocen mają większy wpływ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加權平均按各平台的評分人數分配權重，評分人數越多的平台佔比越大。"
          }
        }
      }
    },
