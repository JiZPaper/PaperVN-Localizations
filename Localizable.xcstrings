    "登录Paper账户或任意平台账户以使用资料库。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei Paper Account oder einem beliebigen Plattform-Account an, um die Bibliothek zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to Paper Account or any platform account to use Library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paper Accountまたはいずれかのプラットフォームのアカウントにサインインすると、ライブラリを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paper 계정 또는 플랫폼 계정 중 하나에 로그인하면 라이브러리를 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się do konta Paper lub dowolnego konta platformy, aby korzystać z Biblioteki."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入Paper帳號或任一平台帳號以使用資料庫。"
