        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索的なおすすめです。作品品質の信頼性は高いものの、個人向けの根拠は限られています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐색 추천입니다. 작품 품질 신호는 신뢰할 만하지만 개인화 근거는 제한적입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
