        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外するときは、1つの条件グループに入れられる項目は1つだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외할 때는 한 조건 그룹에 항목을 하나만 넣을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wykluczaniu grupa warunków może zawierać tylko jeden element."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除時一組篩選條件裡只能有一個篩選項。"
          }
        }
      }
    },
