    "保留所有资料库中的作品，并手动确认冲突内容。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält Titel aus allen Mediatheken. Konflikte bestätigst du manuell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps titles from all libraries and lets you confirm conflicts manually."
