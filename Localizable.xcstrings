    "在不同设备间同步你的偏好数据和Today功能开关设置。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere deine Präferenzdaten und Today-Funktionseinstellungen zwischen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync your preference data and Today feature settings across devices."
          }
        },
        "ja" : {
          "stringUnit" : {
