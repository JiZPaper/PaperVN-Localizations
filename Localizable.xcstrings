    "%@上的更改会导入资料库，资料库中的更改不会同步到%@。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen auf %1$@ werden in die Mediathek importiert. Änderungen in der Mediathek werden nicht mit %2$@ synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes on %1$@ are imported into your library. Changes in your library won’t sync to %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@での変更はライブラリに読み込まれますが、ライブラリでの変更は%2$@に同期されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 변경 사항은 보관함으로 가져오지만, 보관함의 변경 사항은 %2$@에 동기화되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany w serwisie %1$@ są importowane do biblioteki. Zmiany w bibliotece nie są synchronizowane z serwisem %2$@."
