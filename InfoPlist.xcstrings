    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um eine Verbindung mit einem PotatoVN-Synchronisierungsserver im lokalen Netzwerk herzustellen und die Spielzeit zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to connect to a PotatoVN sync server on your local network to read play time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク上のPotatoVN同期サーバに接続して、プレイ時間を読み込むために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크에 있는 PotatoVN 동기화 서버에 연결하여 플레이 시간을 읽는 데 사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do łączenia się z serwerem synchronizacji PotatoVN w sieci lokalnej i odczytywania czasu gry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "用于连接本地网络中的PotatoVN同步服务器，读取游玩时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於連線區域網路中的PotatoVN同步伺服器，讀取遊玩時間。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um Cover von Visual Novels, Charakterbilder und Bildschirmfotos in „Fotos“ zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to save visual novel covers, character images, and screenshots to Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアルノベルの表紙、キャラクターの画像、スクリーンショットを“写真”に保存するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비주얼 노벨 표지, 캐릭터 이미지 및 스크린샷을 ‘사진’에 저장하는 데 사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do zapisywania okładek powieści wizualnych, obrazów postaci i zrzutów ekranu w aplikacji Zdjęcia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于将视觉小说封面、角色图像和截屏保存到“照片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將視覺小說封面、角色影像和截圖儲存到「照片」。"
          }
        }
      }
    },
