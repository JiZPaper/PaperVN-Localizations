    "查看今天播出的动画与播出时间。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, welche Anime heute ausgestrahlt werden und wann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the anime airing today and when each episode airs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日放送されるアニメと放送時刻を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 방영되는 애니메이션과 방영 시간을 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz anime emitowane dzisiaj i godziny emisji."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視今天播出的動畫與播出時間。"
          }
        }
      }
    },
    "查看资料库中玩过或看过的作品里今天过生日的角色。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, welche Figuren aus den Werken in deiner Mediathek heute Geburtstag haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See characters from titles you’ve enjoyed in your library who have a birthday today."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリの遊んだ・観た作品から、今日が誕生日のキャラクターを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함에서 플레이하거나 본 작품의 캐릭터 중 오늘 생일인 캐릭터를 확인합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz postaci z tytułów w twojej bibliotece, które mają dziś urodziny."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視資料庫中玩過或看過的作品裡今天過生日的角色。"
          }
        }
      }
    },
